# Dev profile (default)
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/ecommerce_dev?createDatabaseIfNotExist=true
DB_USER=root
DB_PASSWORD=root
JWT_SECRET=change-this-secret-to-at-least-32-characters
JWT_EXPIRATION_SECONDS=7200
SQL_INIT_MODE=never

